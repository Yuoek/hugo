
/* Generated using: hugo gen chromastyles --style=murphy */

/* Background */ .bg { background-color:#faa1; }
/* PreWrapper */ .chroma { background-color:#fff0; }
/* Error */ .chroma .err { color:#f00;background-color:#fbfbfb00 }
/* LineLink */ .chroma .lnlinks { outline:none;text-decoration:none;color:inherit }
/* LineTableTD */ .chroma .lntd { vertical-align:top;padding:0;margin:0;border:0; }
/* LineTable */ .chroma .lntable { border-spacing:0;padding:0;margin:0;border:0; }
/* LineHighlight */ .chroma .hl { background-color:#e5e5e5 }
/* LineNumbersTable */ .chroma .lnt { white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f }
/* LineNumbers */ .chroma .ln { white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#7f7f7f }
/* Line */ .chroma .line { display:flex; }
/* Keyword */ .chroma .k { color:#289;font-weight:bold }
/* KeywordConstant */ .chroma .kc { color:#289;font-weight:bold }
/* KeywordDeclaration */ .chroma .kd { color:#289;font-weight:bold }
/* KeywordNamespace */ .chroma .kn { color:#289;font-weight:bold }
/* KeywordPseudo */ .chroma .kp { color:#08f;font-weight:bold }
/* KeywordReserved */ .chroma .kr { color:#289;font-weight:bold }
/* KeywordType */ .chroma .kt { color:#66f;font-weight:bold }
/* NameAttribute */ .chroma .na { color:#007 }
/* NameClass */ .chroma .nc { color:#e9e;font-weight:bold }
/* NameConstant */ .chroma .no { color:#5ed;font-weight:bold }
/* NameDecorator */ .chroma .nd { color:#555;font-weight:bold }
/* NameEntity */ .chroma .ni { color:#800 }
/* NameException */ .chroma .ne { color:#f00;font-weight:bold }
/* NameLabel */ .chroma .nl { color:#970;font-weight:bold }
/* NameNamespace */ .chroma .nn { color:#0e84b5;font-weight:bold }
/* NameTag */ .chroma .nt { color:#070 }
/* NameBuiltin */ .chroma .nb { color:#072 }
/* NameBuiltinPseudo */ .chroma .bp { color:#072 }
/* NameVariable */ .chroma .nv { color:#036 }
/* NameVariableClass */ .chroma .vc { color:#ccf }
/* NameVariableGlobal */ .chroma .vg { color:#f84 }
/* NameVariableInstance */ .chroma .vi { color:#aaf }
/* NameVariableMagic */ .chroma .vm { color:#036 }
/* NameFunction */ .chroma .nf { color:#5ed;font-weight:bold }
/* NameFunctionMagic */ .chroma .fm { color:#5ed;font-weight:bold }
/* LiteralString */ .chroma .s { background-color:#e0e0ff }
/* LiteralStringAffix */ .chroma .sa { background-color:#e0e0ff }
/* LiteralStringBacktick */ .chroma .sb { background-color:#e0e0ff }
/* LiteralStringChar */ .chroma .sc { color:#88f;background-color:#e0e0ff }
/* LiteralStringDelimiter */ .chroma .dl { background-color:#e0e0ff }
/* LiteralStringDoc */ .chroma .sd { color:#d42;background-color:#e0e0ff }
/* LiteralStringDouble */ .chroma .s2 { background-color:#e0e0ff }
/* LiteralStringEscape */ .chroma .se { color:#666;background-color:#e0e0ff;font-weight:bold }
/* LiteralStringHeredoc */ .chroma .sh { background-color:#e0e0ff }
/* LiteralStringInterpol */ .chroma .si { background-color:#eee }
/* LiteralStringOther */ .chroma .sx { color:#f88;background-color:#e0e0ff }
/* LiteralStringRegex */ .chroma .sr { color:#000;background-color:#e0e0ff }
/* LiteralStringSingle */ .chroma .s1 { background-color:#e0e0ff }
/* LiteralStringSymbol */ .chroma .ss { color:#fc8;background-color:#e0e0ff }
/* LiteralNumber */ .chroma .m { color:#60e;font-weight:bold }
/* LiteralNumberBin */ .chroma .mb { color:#60e;font-weight:bold }
/* LiteralNumberFloat */ .chroma .mf { color:#60e;font-weight:bold }
/* LiteralNumberHex */ .chroma .mh { color:#058;font-weight:bold }
/* LiteralNumberInteger */ .chroma .mi { color:#66f;font-weight:bold }
/* LiteralNumberIntegerLong */ .chroma .il { color:#60e;font-weight:bold }
/* LiteralNumberOct */ .chroma .mo { color:#40e;font-weight:bold }
/* Operator */ .chroma .o { color:#333 }
/* OperatorWord */ .chroma .ow { color:#000;font-weight:bold }
/* Comment */ .chroma .c { color:#666;font-style:italic }
/* CommentHashbang */ .chroma .ch { color:#666;font-style:italic }
/* CommentMultiline */ .chroma .cm { color:#666;font-style:italic }
/* CommentSingle */ .chroma .c1 { color:#666;font-style:italic }
/* CommentSpecial */ .chroma .cs { color:#c00;font-weight:bold;font-style:italic }
/* CommentPreproc */ .chroma .cp { color:#579 }
/* CommentPreprocFile */ .chroma .cpf { color:#579 }
/* GenericDeleted */ .chroma .gd { color:#a00000 }
/* GenericEmph */ .chroma .ge { font-style:italic }
/* GenericError */ .chroma .gr { color:#f00 }
/* GenericHeading */ .chroma .gh { color:#000080;font-weight:bold }
/* GenericInserted */ .chroma .gi { color:#00a000 }
/* GenericOutput */ .chroma .go { color:#888 }
/* GenericPrompt */ .chroma .gp { color:#c65d09;font-weight:bold }
/* GenericStrong */ .chroma .gs { font-weight:bold }
/* GenericSubheading */ .chroma .gu { color:#800080;font-weight:bold }
/* GenericTraceback */ .chroma .gt { color:#04d }
/* GenericUnderline */ .chroma .gl { text-decoration:underline }
/* TextWhitespace */ .chroma .w { color:#bbb }

/* --------------------------------------------- */

/* 没有prose类，手动模拟排版 */
section p {
  margin: 1.25rem 0;
  line-height:1.75;
}
section h2 {
  margin: 2.2rem 0 1rem;
}
section h3 {
  margin:1.8rem 0 0.8rem;
}
section ul,section ol {
  margin:1rem 0;
}
section blockquote {
  margin:1.2rem 0;
}
/* 文章页面，让main容器冲破container限制 */
main:has(.prose) {
  max-width: 100% !important;
  padding-left: 0 !important;
  padding-right: 0 !important;
}

/* 给内部内容左右留一点边距，防止文字贴屏幕边缘 */
.prose {
  padding-left: 1rem;
  padding-right: 1rem;
}

/* 左上角导航站点标题字体样式 */
.main-menu nav a[href="/ja/"],
.main-menu nav a[href="/fr/"],
.main-menu nav a[href="/es/"],
.main-menu nav a[href="/en/"],
.main-menu nav a[href="/"] {
    font-family: "delphiaVillagefont", serif;
    font-size: 1.85rem;
}

/* hover状态保持字体不变，只改颜色 */
.main-menu nav a[href="/"]:hover {
    color: #ee98e3de;
}

@layer utilities {
  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.75rem;
    padding: 0.75rem 0;
  }
}

/* 隐藏播放器侧边切换箭头（miniswitcher） */
.aplayer-fixed .aplayer-miniswitcher {
    display: none !important;
}

.github-card-wrapper > a > div {
    box-shadow: none !important;
    border-radius: 0 !important;
    max-width: 480px;
    transform: scale(0.9);
    transform-origin: top left;
}

/* 小屏幕下恢复正常大小 */
@media (max-width: 768px) {
  .github-card-wrapper > a > div {
    max-width: 100%;
    transform: none;
  }
}

/*------------------------------------------------------------------------*/
/* 取消最大限制宽度 */
.max-w-prose {
  max-width: none !important;
}

@font-face {
  font-family: 'title-font';
  src: url('/fonts/美绩点阵体.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
  unicode-range: U+4E00-9FFF;  /* 只包含 CJK 中文范围 */
}

@font-face {
  font-family: 'list-font';
  src: url('/fonts/思源宋体花样钻纹.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
  unicode-range: U+4E00-9FFF;  /* 只包含 CJK 中文范围 */
}

@font-face {
  font-family: 'list-font-en';
  src: url('/fonts/VerondSon-Regular.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

@font-face {
  font-family: 'title-font-en';
  src: url('/fonts/SuperMarioDsRegular-Ea4R8.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

/* 正文中文：方正仿宋简体，限定只作用CJK字符 */
@font-face {
  font-family: 'posts-font';
  src: url('/fonts/方正仿宋简体.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
  unicode-range:
    U+4E00-9FFF,     /* 汉字 */
    U+3040-309F,     /* 平假名 */
    U+30A0-30FF,     /* 片假名 */
    U+FF00-FFEF;     /* 全角符号（全角标点、全角数字） */
}

/* 正文英文：VerondSon‑Regular，限定拉丁字母区间 */
@font-face {
  font-family: 'posts-font-en';
  src: url('/fonts/SuperSimpleBrushScript-1Wy2.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
  unicode-range:
      U+0000-002F,
      U+0030-0039,
      U+003A-007F,
      U+0080-00FF,
      U+0100-017F,
      U+0180-024F;
}

/* 代码字体 */
@font-face {
  font-family: 'code-font';
  src: url('/fonts/JetBrainsMonoNerdFontMono-BoldItalic.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
  unicode-range:
      U+0000-002F,
      U+0030-0039,
      U+003A-007F,
      U+0080-00FF,
      U+0100-017F,
      U+0180-024F;
}

@font-face {
    font-family: 'ChineseFont';
    src: url('/fonts/ChillKai.woff') format('woff');
    font-display: swap;
    unicode-range:
    U+4E00-9FFF, U+3040-309F, U+30A0-30FF, U+FF00-FFEF;
}

@font-face {
    font-family: 'EnglishFont';
    src: url('/fonts/HanaMinA.ttf');
    font-display: swap;
    unicode-range:
        U+0000-007F,
        U+0080-00FF,
        U+0100-017F,
        U+0180-024F;
}

@font-face {
    font-family: 'letterfont-zh';
    src: url('/fonts/zqp.ttf') format('truetype');
    font-display: swap;
}
@font-face {
    font-family: 'catalinafont';
    src: url('/fonts/Catalina.ttf') format('truetype');
    font-display: swap;
}
@font-face {
    font-family: 'hastheyafont';
    src: url('/fonts/Hastheya.otf') format('truetype');
    font-display: swap;
}
@font-face {
    font-family: 'verondsonfont';
    src: url('/fonts/VerondSon-Regular.ttf') format('truetype');
    font-display: swap;
}
@font-face {
    font-family: 'delphiaVillagefont';
    src: url('/fonts/DelphiaVillage.otf') format('truetype');
    font-display: swap;
}

/* 文章正文，仅作用于 .prose，不污染全局 */
.prose p,
.prose li,
.prose ul,
.prose ol,
.prose blockquote,
.prose code:not([class*="language-"]) {
  font-family: posts-font-en, posts-font, system-ui, sans-serif;
}

/* 侧边分类卡片标题 */
.group-hover-card-title {
    font-family: list-font-en, list-font, system-ui;
}

h1:lang(zh), h2:lang(zh), h3:lang(zh), h4:lang(zh), h5:lang(zh), h6:lang(zh) {
  font-family: title-font-en, title-font;
}

html {
    font-family: 'ChineseFont', 'EnglishFont', sans-serif;
    font-size: 16px;
}

/* --------修复 relative‑group flex吃掉标题margin-------- */
.prose .relative-group {
  display: block !important;
  position: relative;
}
.prose .relative-group > .anchor {
  position: absolute;
  left: -1.75rem;
  top: 0;
}

/* 添加字体预加载优化 */
link[rel="preload"] {
    as: "font";
    type: "font/woff";
    crossorigin: "anonymous";
}

h1 {
    color: #ee98e3de;
}

/* Blowfish congo主题 灰度字修改 */
.text-neutral-900,
.text-neutral-500 {
  color: #000000;
}

.dark .text-neutral-900,
.dark .text-neutral-500 {
  color: #ffff;
}

/*------------------------------------------------------------------------*/

/* 粗体 */
b, strong {
  margin: 1px 1px;
  padding: 1px;
  color: rgba(46, 64, 91, 0.94);
  background-color: rgba(255, 205, 204, 0.54);
  font-weight: 400;
}

/* 暗黑模式 */
.dark b, .dark strong {
  margin: 1px 1px;
  padding: 1px;
  color: rgb(255, 255, 255, 0.90);
  background-color: rgba(255, 205, 204, 0.54);
  font-weight: 400;
}

/* 行内代码 */
code:not(pre code) {
  margin: 1px 1px;
  padding: 1px;
  color: rgba(46, 64, 91, 0.94);
  background-color: rgba(129, 223, 231, 0.50);
  font-weight: 400;
}

/* 暗黑模式 */
.dark code:not(pre code) {
  margin: 1px 1px;
  padding: 1px;
  color: rgb(255, 255, 255, 0.90);
  background-color: rgba(129, 223, 231, 0.90);
  font-weight: 400;
}

/* 修改暗色模式下代码块里的代码文字背景透明 */
.prose .chroma {
      position: static;
      border-radius: 0;
      background-color: rgb(185 227 233 / 00%);
      color: rgb(231 66 134);
      border: 1px solid rgba(124, 192, 231, 0.5);
}
.dark .prose .chroma {
      position: static;
      border-radius: var(--radius-md);
      background-color: rgb(185 227 233 / 00%);
      color: rgb(231 66 134);
      border: 2px solid rgb(185 227 233 / 60%);
}

/* -------------------------------------------------------------------------*/

/* 设置代码块字体 */
pre, code {
    font-family:  'code-font', 'ChineseFont';
    font-size: 12px;
    line-height: 1.5;
    overflow-x: auto;
    max-height: 400px;
    overflow-y: auto;
}

