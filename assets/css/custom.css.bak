.highlight pre .line {
  position: relative;
  display: block;
  line-height: 1.5;
}
/* Aplayer 样式修改 */
.aplayer,
.aplayer .aplayer-body,
.aplayer .aplayer-info,
.aplayer .aplayer-list,
.aplayer .aplayer-lrc,
.aplayer.aplayer-fixed .aplayer-icon,
.aplayer .aplayer-notice {
    background: transparent !important;
    font-family:  'EnglishFont', 'ChineseFont';
    box-shadow: none !important;
}

.aplayer .aplayer-icon path {
    fill: #FFA500 !important;
    box-shadow: none !important;
}

.aplayer.aplayer-fixed .aplayer-icon path {
    fill: #87CEEB !important;
}

.aplayer .aplayer-lrc {
    background: transparent !important;
    box-shadow: none !important;
}
.aplayer .aplayer-lrc p.aplayer-lrc-current {
    color: #FF69B4 !important;
}
.aplayer .aplayer-lrc p {
    color: #0000FF !important;
    box-shadow: none !important;
    text-shadow: none !important;
}

.aplayer .aplayer-lrc:before,
.aplayer .aplayer-lrc:after {
    background: none !important;
}

.aplayer .aplayer-pic,
.aplayer .aplayer-pic .aplayer-button {
    border-radius: 50% !important;
    box-shadow: none !important;
}

#fixed-aplayer {
    position: fixed;
    z-index: 1000;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
}

/* -------------------------------------------------------------------------*/

/* Chart‑js */
.chart-container {
    position: relative;
    height: 400px;
    width: 70%;
    margin: 0 auto;
}

canvas {
    display: block;
    max-width: 100%;
    height: 400px;
    width: 70%;
    aspect-ratio: 16/9;
    margin: 0 auto;
}

@media (max-width: 768px) {
    .chart-container {
        height: 400px;
        width: 90%;
    }
    canvas {
        height: 300px;
        width: 90%;
    }
}

/* ---------- 友链卡片样式开始 ---------- */
.friend-link-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 20px;
  background: transparent !important;
  backdrop-filter: blur(55px);
  -webkit-backdrop-filter: blur(65px);
}

a.friend-link {
  text-decoration: none;
  color: inherit;
  background-size: 0 !important;
  display: block;
  width: 100%;
  max-width: 600px;
  margin: 1rem auto;
  text-decoration: none;
  border-radius: 12px;
  overflow: hidden;
  background: transparent !important;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  transition: transform 0.2s ease;
  border: 1px solid rgba(255, 255, 255, 0.3);
}

a.friend-link:hover {
  text-decoration: none;
  color: inherit;
  background-size: 0 !important;
  transform: translateY(-2px);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
}

.friend-link-div {
  display: flex;
  align-items: center;
  padding: 0 16px;
}

.friend-avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
  margin-right: 10px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  transition: transform 0.3s ease;
}

a.friend-link:hover .friend-avatar {
  transform: rotate(360deg);
}

.friend-link-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.friend-name {
  font-size: 16px;
  font-weight: bolder;
  font-style: normal;
  color: #333;
  margin-bottom: 0;
  margin-top: 0;
  margin-left: 12px;
}

.friend-bio {
  font-size: 14px;
  color: #555;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-top: 0;
  margin-bottom: 0;
  margin-left: 12px;
}

/* 夜间模式适配 */
.dark .friend-link-container {
  background: transparent !important;
}

.dark .friend-link {
  background: transparent !important;
  box-shadow: 0 4px 20px rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.dark .friend-name {
  color: #eee;
}

.dark .friend-bio {
  color: #DDD;
}

.dark .friend-avatar {
  border-color: rgba(255, 255, 255, 0.3);
}

@media screen and (max-width: 600px) {
  .friend-link-container {
    padding: 15px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .friend-link-div {
    flex-direction: row;
    padding: 12px 16px;
  }
  .friend-avatar {
    width: 56px;
    height: 56px;
    margin-right: 12px;
  }
  .friend-name {
    font-size: 16px;
  }
  .friend-bio {
    font-size: 14px;
  }
}

.friend-link-container,
.friend-link {
  transition: backdrop-filter 0.3s ease, background 0.3s ease;
}

.friend-link-container::before {
  content: '';
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  z-index: -1;
}

.friend-link-container > * {
  position: relative;
  z-index: 1;
}

/* 自定义工具字体类 */
.fonts-letter-zh {
    font-family: 'letterfont-zh', sans-serif;
    color: rgba(2, 2, 2, 1);
    font-size: 1.214rem;
}
.fonts-catalina {
    font-family: 'catalinafont', sans-serif;
    font-size: 1.214rem;
}
.fonts-hastheya {
    font-family: 'hastheyafont', sans-serif;
    font-size: 1.214rem;
}
.fonts-verondson {
    font-family: 'verondsonfont', sans-serif;
    font-size: 40px;
}
.fonts-delphiaVillagefont {
    font-family: 'delphiaVillagefont', sans-serif;
    font-size: 48px;
    color: #ee98e3de;
}
